<%- include("../includes/head.ejs") %>

<link rel="stylesheet" href="/adminDashboard.css">

<div class="container mt-5">

<div class="d-flex justify-content-between align-items-center">
    <h1>Admin Dashboard</h1>

    <a href="/register" class="btn btn-primary">
        Add Student
    </a>
</div>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card admin-card">
            <div class="card-body">
                <h5>Total</h5>
                <h2>
                    <%= totalComplaints %>
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card admin-card">
            <div class="card-body">
                <h5>Pending</h5>
                <h2>
                    <%= pendingComplaints %>
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card admin-card">
            <div class="card-body">
                <h5>In Progress</h5>
                <h2>
                    <%= inProgressComplaints %>
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card admin-card">
            <div class="card-body">
                <h5>Resolved</h5>
                <h2>
                    <%= resolvedComplaints %>
                </h2>
            </div>
        </div>
    </div>

</div>

<h3 class="mt-5">Complaints</h3>

<div class="table-container mt-3">

    <table class="table align-middle">

        <thead>
            <tr>
                <th>Complaint ID</th>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            <% complaints.forEach(complaint=> { %>

                <tr>

                    <td>
                        <%= complaint.complaintId %>
                    </td>

                    <td>
                        <%= complaint.title %>
                    </td>

                    <td>
                        <%= complaint.category %>
                    </td>

                    <td>
                        <span class="badge bg-warning status-badge">
                            <%= complaint.status %>
                        </span>
                    </td>

                    <td>
                        <a href="/admin/complaints/<%= complaint._id %>/edit"
                            class="btn btn-sm btn-primary">
                            Manage
                        </a>
                    </td>

                </tr>

                <% }) %>

        </tbody>

    </table>

</div>

<h3 class="mt-5">Daily Announcements</h3>

<div class="card mt-3">

    <div class="card-body">

        <form action="/admin/announcements" method="POST">

            <div class="mb-3">

                <label class="form-label">
                    Announcement Title
                </label>

                <input
                    type="text"
                    name="title"
                    class="form-control"
                    placeholder="Enter announcement title"
                    required
                >

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Announcement
                </label>

                <textarea
                    name="message"
                    class="form-control"
                    rows="4"
                    placeholder="Write today's announcement..."
                    required
                ></textarea>

            </div>

            <button
                type="submit"
                class="btn btn-primary"
            >
                Publish Announcement
            </button>

        </form>

    </div>

</div>

</div>

<%- include("../includes/footer.ejs") %>
