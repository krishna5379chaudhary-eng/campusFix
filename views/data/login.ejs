<%- include("../includes/head.ejs") %>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card p-4">

                <h2 class="text-center mb-4">
                    CampusFix Login
                </h2>

                <form action="/login" method="POST">

                    <div class="mb-3">

                        <label class="form-label">
                            Student ID / Admin ID
                        </label>

                        <input
                            type="text"
                            name="studentId"
                            class="form-control"
                            required
                        >

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            class="form-control"
                            required
                        >

                    </div>


                    <button class="btn btn-primary w-100">
                        Login
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<%- include("../includes/footer.ejs") %>