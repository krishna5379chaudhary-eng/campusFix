<%- include("../includes/head.ejs") %>
<%- include("../includes/navbar.ejs") %>

<div class="container mt-5">

    <h1>Student Registration</h1>

    <% if (success) { %>

        <div class="alert alert-success mt-3">
            <%= success %>
        </div>

    <% } %>

    <form action="/register" method="POST">

        <div class="mb-3">
            <label for="name" class="form-label">
                Student Name
            </label>

            <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                required
            >
        </div>


        <div class="mb-3">
            <label for="studentId" class="form-label">
                Student ID
            </label>
git status
            <input
                type="text"
                id="studentId"
                name="studentId"
                class="form-control"
                required
            >
        </div>


        <div class="mb-3">
            <label for="email" class="form-label">
                College Email
            </label>

            <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                required
            >
        </div>


        <div class="mb-3">
            <label for="password" class="form-label">
                Password
            </label>

            <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                required
            >
        </div>


        <button type="submit" class="btn btn-primary">
            Register
        </button>

    </form>

</div>

<%- include("../includes/footer.ejs") %>