<%- include("../includes/head.ejs") %>
<%- include("../includes/navbar.ejs") %>

<link rel="stylesheet" href="/editComplaint.css">

<div class="container mt-5">

    <h1>Edit Complaint</h1>

    <div class="card mt-4">

        <div class="card-body">

            <h3><%= complaint.title %></h3>

            <p>
                <strong>Complaint ID:</strong>
                <%= complaint.complaintId %>
            </p>

            <hr>

            <h4>Reported By</h4>

            <p>
                <strong>Name:</strong>
                <%= user ? user.name : "Unknown" %>
            </p>

            <p>
                <strong>Student ID:</strong>
                <%= user ? user.studentId : complaint.studentId %>
            </p>

            <p>
                <strong>Email:</strong>
                <%= user ? user.email : "Unknown" %>
            </p>

            <hr>

            <h4>Complaint Details</h4>

            <p>
                <strong>Category:</strong>
                <%= complaint.category %>
            </p>

            <p>
                <strong>Location:</strong>
                <%= complaint.location %>
            </p>

            <p>
                <strong>Description:</strong>
                <%= complaint.description %>
            </p>

            <% if (complaint.image) { %>

                <div class="mt-4">

                    <h4>Complaint Image</h4>

                    <button
                        type="button"
                        class="btn btn-secondary mt-2"
                        data-bs-toggle="modal"
                        data-bs-target="#imageModal"
                    >
                        View Image
                    </button>

                    <div
                        class="modal fade"
                        id="imageModal"
                        tabindex="-1"
                        aria-hidden="true"
                    >

                        <div class="modal-dialog modal-dialog-centered">

                            <div class="modal-content">

                                <div class="modal-header">

                                    <h5 class="modal-title">
                                        Complaint Image
                                    </h5>

                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                    ></button>

                                </div>

                                <div class="modal-body text-center">

                                    <img
                                        src="<%= complaint.image %>"
                                        alt="Complaint Image"
                                        class="img-fluid rounded"
                                    >

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            <% } %>

            <hr>

            <form
                action="/admin/complaints/<%= complaint._id %>"
                method="POST"
            >

                <input type="hidden" name="_method" value="PATCH">

                <div class="mb-3">

                    <label class="form-label">
                        Department
                    </label>

                    <select name="department" class="form-select" required>

                        <option value="Electricity"
                            <%= complaint.department === "Electricity" ? "selected" : "" %>>
                            Electricity
                        </option>

                        <option value="Water"
                            <%= complaint.department === "Water" ? "selected" : "" %>>
                            Water
                        </option>

                        <option value="Cleanliness"
                            <%= complaint.department === "Cleanliness" ? "selected" : "" %>>
                            Cleanliness
                        </option>

                        <option value="Maintenance"
                            <%= complaint.department === "Maintenance" ? "selected" : "" %>>
                            Maintenance
                        </option>

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select name="status" class="form-select" required>

                        <option value="Pending"
                            <%= complaint.status === "Pending" ? "selected" : "" %>>
                            Pending
                        </option>

                        <option value="Assigned"
                            <%= complaint.status === "Assigned" ? "selected" : "" %>>
                            Assigned
                        </option>

                        <option value="In Progress"
                            <%= complaint.status === "In Progress" ? "selected" : "" %>>
                            In Progress
                        </option>

                        <option value="Resolved"
                            <%= complaint.status === "Resolved" ? "selected" : "" %>>
                            Resolved
                        </option>

                    </select>

                </div>

                <button type="submit" class="btn btn-primary">
                    Update Complaint
                </button>

            </form>

            <form
                action="/admin/complaints/<%= complaint._id %>"
                method="POST"
                class="mt-3"
            >

                <input type="hidden" name="_method" value="DELETE">

                <button type="submit" class="btn btn-danger">
                    Delete Complaint
                </button>

            </form>

        </div>

    </div>

</div>

<%- include("../includes/footer.ejs") %>