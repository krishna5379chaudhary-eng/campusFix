<%- include("../includes/head.ejs") %>
<%- include("../includes/navbar.ejs") %>

<div class="container mt-5">
<h1>Daily Announcements</h1>

<div class="alert alert-info mt-4">
    <strong>Announcement Declared</strong>
    <br>
    Latest announcements from the college are shown below.
    <br>
    <small>
        Announcements will automatically be removed from the pages and database after 24 hours.
    </small>
</div>

<% if (announcements.length === 0) { %>

    <div class="alert alert-secondary mt-4">
        No announcements available.
    </div>

<% } %>

<% announcements.forEach(announcement => { %>

    <div class="card mt-4">

        <div class="card-body">

            <h4>
                <%= announcement.title %>
            </h4>

            <p class="mt-3">
                <%= announcement.message %>
            </p>

            <small class="text-muted">
                <%= announcement.createdAt.toLocaleString() %>
            </small>

        </div>

    </div>

<% }) %>git push origin remove-node-modules
</div>

<%- include("../includes/footer.ejs") %>
